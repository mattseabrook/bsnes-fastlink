#include "../../emulator/version.hpp"

1 24 "bsnes.Manifest"
2 ICON DISCARDABLE "bsnes.ico"

1 VERSIONINFO
FILEVERSION FASTLINK_VERSION_MAJOR,FASTLINK_VERSION_MINOR,FASTLINK_VERSION_DATE_WORD,FASTLINK_VERSION_BUILD
PRODUCTVERSION FASTLINK_VERSION_MAJOR,FASTLINK_VERSION_MINOR,FASTLINK_VERSION_DATE_WORD,FASTLINK_VERSION_BUILD
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "bsnes-fastlink"
      VALUE "FileVersion", FASTLINK_VERSION_STRING
      VALUE "InternalName", "bsnes-fastlink"
      VALUE "OriginalFilename", "bsnes.exe"
      VALUE "ProductName", "bsnes-fastlink"
      VALUE "ProductVersion", FASTLINK_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
